# Production environment for the Droplet.
#
# Copy to `.env` next to docker-compose.prod.yml, fill in, then:
#   chmod 600 .env
#
# This file has two jobs, which is worth understanding because it trips people:
#   1. Compose reads it for ${VAR} interpolation inside docker-compose.prod.yml
#      (that's how the db service gets POSTGRES_*)
#   2. It is passed wholesale into the api container via env_file
#
# NEVER commit the filled-in version.

# --- Postgres container ---
# Generate the password: openssl rand -base64 32
# Do NOT reuse the local docker-compose.yml credentials (abacadaba/abacadaba).
POSTGRES_USER=abacadaba
POSTGRES_PASSWORD=
POSTGRES_DB=abacadaba

# --- Backend ---
# Host is `db` (the compose service name), not localhost. The explicit
# +psycopg driver matters: a bare postgresql:// resolves to psycopg2, which
# is not installed. app/config.py normalizes this anyway, but be explicit.
DATABASE_URL=postgresql+psycopg://abacadaba:CHANGEME@db:5432/abacadaba

CORS_ORIGINS=https://abacadaba.com
SITE_URL=https://abacadaba.com

# Cookie: Secure because everything is behind TLS, and the leading dot on the
# domain so the session is sent to both abacadaba.com and api.abacadaba.com.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.abacadaba.com

# Disables /docs and /redoc.
ENVIRONMENT=production

# --- DigitalOcean Spaces ---
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=abacadaba
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# --- Admin, used only by scripts/upload_video.py ---
# Not needed by the running API. Only set these if you run the upload script
# from the Droplet; normally you run it from your laptop instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
